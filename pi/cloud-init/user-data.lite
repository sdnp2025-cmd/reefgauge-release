#cloud-config
# ReefGauge golden-image build card — Raspberry Pi OS **Lite**.
#
# Everything here runs once, on the first boot of a freshly written card, before
# anything else touches the unit. It exists so that building a sellable image is
# a repeatable process rather than a list of steps someone has to remember: each
# raspi-config line below was a manual instruction in docs/FACTORY.md, and a
# manual step in a factory process is a defect waiting for a tired evening.
#
# Lite, not the desktop image. There is no desktop to autologin into and none to
# hide: the kiosk is cage on tty1, installed as a system service by
# pi/install.sh. Most of what the desktop build spent its configuration on —
# suppressing the taskbar, the default-password prompt, the on-screen keyboard
# and the file manager's wallpaper — simply does not exist here.
#
# The SSH key is for BUILDING this image. pi/install.sh --factory deletes it
# before the card is imaged, so no shipped unit carries a way in.

manage_resolv_conf: false

# Lowercase deliberately: mixed-case hostnames are handled inconsistently by
# some tooling, and the docs and the puck's service lookup both use lowercase.
hostname: reef-terminal
manage_etc_hosts: true
# --------------------------------------------------------------- root size --
# prepare-card.sh removed the "resize" token from cmdline.txt, so nothing grows
# the root partition any more. Grow it to a fixed size instead.
#
# This has to happen in bootcmd and not runcmd: the stock Lite root is ~2.3 GiB
# with about a gigabyte spare, and the packages below plus Node, the npm tree
# and the dashboard build come to roughly 5 GB. bootcmd runs in cloud-init's
# init stage, before packages; runcmd runs at the very end, far too late.
#
# Everything here is a no-op the second time: on a shipped unit the partition is
# already this size, so it exits before touching anything. It has to be, because
# bootcmd runs on EVERY boot, including on a sealed read-only unit.
bootcmd:
  - |
    # Grow the root partition to a fixed size, early, before the package install.
    #
    # Logs to the FAT boot partition on purpose: it is the only filesystem this
    # project can read from a Mac without the Pi running, and when this step goes
    # wrong the symptom is a unit that cannot be reached at all. The first version
    # of this sent parted's output to /dev/null and swallowed its exit status, so
    # when it failed the evidence was a half-built card and nothing else.
    set -u
    LOG=/boot/firmware/reefgauge-grow.log
    # Stop Debian's unattended apt before anything else in the build needs apt.
    #
    # apt-daily-upgrade ran during a golden-image build, held the dpkg lock, and
    # while the boot-screen step politely waited for it, that upgrade installed a
    # new openssh-server and restarted sshd - which dropped the build's SSH
    # connection mid-script. The unit ended up with plymouth installed and its
    # cmdline never edited: a splash that could not appear.
    #
    # A sealed unit updates by git into /data, never with apt, so these have
    # nothing to do here at any point. The factory step masks them too; this is
    # earlier, before cloud-init's own package install.
    systemctl mask apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1 || true
    systemctl stop apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1 || true
    TARGET_MIB=7168
    DISK=/dev/mmcblk0
    PART=/dev/mmcblk0p2
    say() { echo "$(date -u +%FT%TZ 2>/dev/null) reefgauge-grow: $*" | tee -a "$LOG" 2>/dev/null || true; }

    [ -b "$PART" ] || exit 0
    cur=$(blockdev --getsize64 "$PART" 2>/dev/null || echo 0)
    tgt=$(( TARGET_MIB * 1048576 ))

    # Already this size: the shipped-unit case, and the common one, since bootcmd
    # runs on every boot. Leave without writing anything.
    [ "$cur" -ge "$tgt" ] && exit 0

    # A read-only root is a sealed unit, and resizing one is never right.
    if ! touch /.reefgauge-rw-probe 2>/dev/null; then
      say "root is read-only - not resizing"; exit 0
    fi
    rm -f /.reefgauge-rw-probe

    say "root partition is $(( cur / 1048576 )) MiB, growing to ${TARGET_MIB} MiB"

    # sfdisk, not parted. parted refuses to resize a partition that is in use,
    # and / is in use by definition here - it is the filesystem this is running
    # from. sfdisk --no-reread writes the table anyway and partx -u updates the
    # kernel's view through BLKPG, which is what growpart does for the same
    # reason. parted is kept only as a fallback.
    grown=0
    if echo ",${TARGET_MIB}M" | sfdisk --no-reread --force -N 2 "$DISK" >> "$LOG" 2>&1; then
      grown=1
    else
      say "sfdisk failed, trying parted"
      parted -s "$DISK" resizepart 2 "${TARGET_MIB}MiB" >> "$LOG" 2>&1 && grown=1
    fi

    if [ "$grown" -ne 1 ]; then
      say "COULD NOT GROW THE PARTITION - root stays $(( cur / 1048576 )) MiB and the install will not fit"
      exit 0
    fi

    partx -u "$DISK" >> "$LOG" 2>&1 || partprobe "$DISK" >> "$LOG" 2>&1 || true
    new=$(blockdev --getsize64 "$PART" 2>/dev/null || echo 0)
    say "partition is now $(( new / 1048576 )) MiB"
    if [ "$new" -le "$cur" ]; then
      say "the kernel did not pick up the new size - not touching the filesystem"
      exit 0
    fi

    if resize2fs "$PART" >> "$LOG" 2>&1; then
      say "filesystem grown to $(df -h / 2>/dev/null | awk 'NR==2 {print $2}')"
    else
      say "resize2fs FAILED - the partition grew but the filesystem did not"
    fi
packages:
  # The terminal advertises itself as _reefgauge._tcp so the CO2 puck can find
  # it by service rather than by name — every unit ships with the same hostname
  # and mDNS silently renames the second one it sees.
  - avahi-daemon
  # The kiosk: a wlroots compositor that runs one fullscreen client and nothing
  # else. Lite has no compositor at all without it.
  - cage
  # And something for it to run. Lite does not ship a browser; the desktop image
  # does, which is why nothing installed it until now. Without it the kiosk
  # restart-loops into a black screen, and the render check in update.sh - which
  # exists because a brownout once shipped a zero-byte bundle - skips silently.
  - chromium
  # Lite ships almost no fonts. Lilita One is bundled with the app, but the body
  # face falls back through faces that exist on macOS and Windows and not here.
  - fonts-dejavu-core
  - fonts-liberation2
  # The alarm is played with aplay (server/src/alarmSound.js) and Lite does not
  # ship it. Without this the product's only audible alarm is silent, and the
  # spawn failure is swallowed, so nothing reports it.
  - alsa-utils
  # The USB backup flow looks for a mounted drive. Lite mounts nothing on its
  # own, so without this a stick physically in the port reads as
  # "no USB drive is plugged in".
  - udisks2
  # For confirming the SCD41 answers: i2cdetect -y 1 should show 62.
  - i2c-tools
  - git
  - curl

apt:
  preserve_sources_list: true
  conf: |
    Acquire {
      Check-Date "false";
    };

timezone: America/New_York
keyboard:
  model: pc105
  layout: "us"

users:
  - name: pi
    shell: /bin/bash
    # video/render for the DRM device and input for the touchscreen: cage needs
    # all three or it exits immediately and the wall stays black.
    groups: [adm, dialout, cdrom, sudo, audio, video, plugdev, games, users, input, netdev, render]
    # No password, by design. A byte-identical image cannot carry a unique
    # per-unit password, and a shared one is precisely the shipped default
    # credential that UK PSTI and the EU CRA prohibit. So there is no password:
    # the kiosk owns the screen, and remote access is the customer-initiated
    # support relay, not a login.
    lock_passwd: true
    # install.sh needs unattended sudo to build the image. The factory step
    # narrows this to the specific commands the running product needs.
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - __SSH_KEY__

# Key only. Never a password, at any point in this card's life.
ssh_pwauth: false

runcmd:
  # Radio unblocked so the customer's wizard can find their network. No Wi-Fi is
  # configured here, deliberately — the buyer does that in the wizard, and a
  # bench network baked into the image would ship inside every card.
  - [ rfkill, unblock, wifi ]
  - [ sh, -c, "for f in /var/lib/systemd/rfkill/*:wlan; do echo 0 > \"$f\"; done" ]

  # I2C for the SCD41. Was "next step 2" printed at the end of install.sh —
  # i.e. a thing a human had to remember on every single build.
  - [ raspi-config, nonint, do_i2c, "0" ]

  # Console blanking off. It is a wall panel; a blank screen is a support call.
  # No do_boot_behaviour here: on Lite there is no desktop to autologin into,
  # and the kiosk takes tty1 as a system service instead.
  - [ raspi-config, nonint, do_blanking, "1" ]

  # The WLAN country. A Raspberry Pi will not scan without one - the radio stays
  # rfkill-soft-blocked - and nothing in this project set it. So the first unit
  # ever booted from a clone reached "Connect to Wi-Fi" and listed nothing, with
  # no way forward. Every build before that had used ethernet, so the one screen
  # every customer meets first was the one screen never tested.
  #
  # US because that is where these ship. It is a legal setting rather than a
  # preference, so it is stated here instead of guessed at runtime; a unit sold
  # elsewhere needs this changed.
  - [ raspi-config, nonint, do_wifi_country, "US" ]

  # Hardware access groups, tolerantly — these exist on Raspberry Pi OS, but one
  # missing must not abort first boot and leave the unit half-built.
  - [ sh, -c, "for g in i2c gpio spi render input video; do adduser pi $g 2>/dev/null || true; done" ]

  # SSH for the build only. Removed from shipped units by the factory step.
  #
  # Written as a script rather than two systemctl calls because getting this
  # wrong is unrecoverable: the password is locked by design, so a unit whose
  # sshd does not work has no way in at all, and the only channel left is this
  # file on the FAT partition - the one filesystem a Mac can read with the Pi
  # powered off. Everything below is harmless on a unit where sshd is fine.
  - |
    DIAG=/boot/firmware/reefgauge-ssh.log
    { echo "=== $(date -u +%FT%TZ 2>/dev/null) reefgauge ssh setup ==="

      # Pi OS ships no host keys and cloud-init's ssh module deletes and
      # regenerates them. If that did not happen, or happened while the disk was
      # full, sshd has nothing to present: it accepts the TCP connection and
      # closes it before any banner, which looks exactly like a network fault.
      echo "--- host keys before ---"; ls -l /etc/ssh/ssh_host_* 2>&1
      ssh-keygen -A 2>&1
      echo "--- host keys after ssh-keygen -A ---"; ls -l /etc/ssh/ssh_host_* 2>&1

      # Debian 13 ships both ssh.service and ssh.socket. If the socket owns port
      # 22, systemd accepts connections and spawns a per-connection sshd that
      # fails - the same accept-then-reset signature. One of the two has to own
      # the port, and for an appliance the long-running service is the simpler
      # choice.
      echo "--- units before ---"
      for u in ssh.service ssh.socket; do
        echo "$u enabled=$(systemctl is-enabled $u 2>&1) active=$(systemctl is-active $u 2>&1)"
      done
      if systemctl is-active --quiet ssh.socket; then
        echo "--- ssh.socket owns :22, handing it to ssh.service ---"
        systemctl disable --now ssh.socket 2>&1
      fi
      systemctl enable ssh.service 2>&1
      systemctl restart ssh.service 2>&1

      echo "--- sshd config test ---"; /usr/sbin/sshd -t 2>&1
      echo "--- units after ---"
      for u in ssh.service ssh.socket; do
        echo "$u enabled=$(systemctl is-enabled $u 2>&1) active=$(systemctl is-active $u 2>&1)"
      done
      echo "--- listening on 22? ---"; ss -lntp 2>&1 | grep -E ':22|State' || echo "nothing on 22"
      echo "--- ssh journal ---"; journalctl -u ssh.service -b --no-pager 2>&1 | tail -25
      echo "--- authorized_keys ---"; ls -l /home/pi/.ssh/ 2>&1; wc -l /home/pi/.ssh/authorized_keys 2>&1
      echo "--- disk + cloud-init ---"; df -h / 2>&1; cloud-init status --long 2>&1
      echo "=== end ==="
    } >> "$DIAG" 2>&1

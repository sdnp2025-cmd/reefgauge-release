node_modules/
dist/
# ...except the puck's firmware, which is a build artefact we deliberately ship:
# it is the only route an update has into a device screwed into a cabinet, so it
# has to be in the release repository that terminals clone from. The bare
# `dist/` above was written for web/dist and matches any directory of that name
# anywhere, which silently swallowed this one - `git add -A` reported nothing.
!firmware/dist/
!firmware/dist/**
data/
server/config.json
__pycache__/
.venv/
.DS_Store

# ESP-IDF build output for the CO2 puck (source lives on the co2-puck branch).
# Ignored here too: switching branches otherwise leaves it as untracked noise
# that stops scripts/release.sh, which refuses to cut a release from a dirty tree.
firmware/build/
firmware/managed_components/
firmware/dependencies.lock

# Built app bundles and intermediate binaries.
console/build/

# Live per-unit provisioning keys. Never commit.
#
# provision.py drops a .gitignore next to this file, but that one lives inside
# a directory the co2-puck branch tracks - so checking out a branch without it
# deletes the .gitignore and leaves the keys exposed and unignored. A secrets
# file protected by something branch-switching can remove is not protected.
firmware/tools/provisioning/*.csv
